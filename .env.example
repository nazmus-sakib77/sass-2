# Copy to .env and fill in real values. Never commit it (.env is gitignored).
# Use .env (not .env.local) so the Prisma CLI (migrate/seed) also reads these vars.

# MySQL connection string (Hostinger Business or local)
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DBNAME"

# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-strong-random-secret"

# Set to the real https domain in production
AUTH_URL="http://localhost:3000"

# Initial admin (used by prisma/seed.ts)
SEED_ADMIN_EMAIL="me@tomotik.com"
SEED_ADMIN_PASSWORD="change-this-strong"
SEED_ADMIN_NAME="Sakib"
